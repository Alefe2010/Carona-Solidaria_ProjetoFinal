direction TB


class Usuario {
    -String CPF
    -String nome
    -String telefone
    -Date dataNasc
    -String email
}


class Veiculo {
    -String placa
    -String cor
    -String modelo
    -int qtdAssentos
}


class Motorista {
    -String CNH
}


class Passageiro {
}


class OfertaCarona {
    -String idOferta
    -int numeroVagas
    -String origem
    -String destino
}


class Solicitacao {
    -String idSolicitacao
    -String situacao
    -DateTime horario
}


class PontoDeEncontro {
    -int idPontoEncontro
    -String bairro
    -String rua
    -String pontoReferencia
}


class Corrida {
    -String idCorrida
    -String situacao
}


class CorridaService {
    +VeiculoRepository veiculoRepository
    +OfertaRepository ofertaRepository
    +SolicitacaoRepository solicitacaoRepository
    +CorridaRepository corridaRepository
    +criarOferta()
    +criarSolicitacao()
    +cadastrarVeiculo()
}


class UsuarioService {
    +UsuarioRepository usuarioRepository
    +cadastrarUsuario()
    +excluirUsuario()
}


class VeiculoRepository {
    +salvarVeiculo(veiculo: Veiculo)
    +buscarPorId(id: String)
    +excluirVeiculo(id: String)
    +atualizarDados(id: String, dados: Veiculo)
}


class UsuarioRepository {
    +cadastrarUsuario(usuario: Usuario)
    +buscarPorId(id: String)
    +atualizarDados(id: String, dados: Usuario)
    +excluirUsuario(id: String)
}


class SolicitacaoRepository {
    +cadastrarSolicitacao(solicitacao: Solicitacao)
    +buscarPorId(id: String)
    +atualizarDados(id: String, dados: Solicitacao)
    +excluirSolicitacao(id: String)
}


class OfertaRepository {
    +cadastrarOferta(oferta: Oferta)
    +buscarPorId(id: String)
    +atualizarDados(id: String, dados: Oferta)
    +excluirOferta(id: String)
}


class CorridaRepository {
    +cadastrarCorrida(corrida: Corrida)
    +buscarPorId(id: String)
    +atualizarDados(id: String, dados: Corrida)
    +excluirCorrida(id: String)
}


Usuario <|-- Motorista
Usuario <|-- Passageiro


Motorista "1" -- "*" Veiculo : Dirige
Motorista "1" -- "*" OfertaCarona : Publica
OfertaCarona "*" -- "1" Veiculo : Utiliza
